{
    "source": {
        "include": [
            "."
        ],
        "exclude": [
            "node_modules",
            "tests"
        ],
        "includePattern": ".+\\.js(doc)?$",
        "excludePattern": "(^|\\/|\\\\)_"
    },
    "opts": {
        "destination": "./docs",
        "recurse": true,
        "template": "node_modules/docdash"
    }
}